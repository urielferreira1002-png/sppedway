# Exemplo de keystore.properties - NÃO COMMITAR senhas reais
# Copie este arquivo para android/keystore.properties e preencha os valores reais

# Caminho para o arquivo do keystore (pode ser absoluto ou relativo à pasta android)
storeFile=../keystore/my-release-key.jks

# Senha do keystore
storePassword=changeit

# Alias da chave dentro do keystore
keyAlias=my-key-alias

# Senha da chave
keyPassword=changeit
